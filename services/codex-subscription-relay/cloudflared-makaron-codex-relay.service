[Unit]
Description=Stable Cloudflare tunnel for Makaron Codex relay (codex-relay.tianyi.live)
After=network-online.target makaron-codex-relay.service
Wants=network-online.target makaron-codex-relay.service

[Service]
Type=simple
User=makaron-codex
Group=makaron-codex
ExecStart=/usr/bin/cloudflared tunnel --config /srv/vlab/makaron-codex-relay/state/cloudflared.yml --no-autoupdate --protocol http2 run
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictRealtime=true
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
