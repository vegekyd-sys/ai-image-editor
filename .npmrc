# Flat node_modules (same layout as npm), still filled from pnpm's global
# content-addressable store, so worktrees share files on disk.
#
# Why not pnpm's default symlinked layout: the Vercel build trace (nft) misses
# @aws-crypto/crc32c, so next.config.ts adds it with outputFileTracingIncludes.
# Those globs can only add files, not the symlinks pnpm uses between packages.
# With the default layout, functions either went over Vercel's 250 MB limit
# (files duplicated under symlink paths) or failed to deploy (symlink entries
# with files beneath them). Keeping npm's flat layout also keeps Capacitor's
# Package.swift paths stable.
node-linker=hoisted
